PROJECT_NAME           = term
PROJECT_BRIEF          = "A C++23 terminal and text UI library"
OUTPUT_DIRECTORY       = .
INPUT                  = @HEADER_INPUTS@ @DOC_INPUTS@
EXAMPLE_PATH           = @EXAMPLE_DIR@
EXAMPLE_PATTERNS       = *.cc
IMAGE_PATH             = @IMAGE_DIR@
USE_MDFILE_AS_MAINPAGE = @MAIN_PAGE@
FILE_PATTERNS          = *.hh *.hpp *.md
RECURSIVE              = NO
INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = doxygen-warnings.log
QUIET                  = YES
